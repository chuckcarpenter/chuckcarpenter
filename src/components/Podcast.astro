---
---

<section id="podcast" class="py-20 px-4 bg-card">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl font-bold text-secondary mb-12 text-center uppercase">
      Latest Episodes
    </h2>

    <div class="space-y-6">
      {[
        { title: 'The Future of Web Dev', date: '2025-03-01', duration: '45 min' },
        { title: 'Retro Design is Cool Again', date: '2025-02-22', duration: '38 min' },
        { title: 'Building in Public', date: '2025-02-15', duration: '52 min' },
      ].map((ep) => (
        <div class="bg-background border-4 border-accent p-6 hover:border-secondary transition-colors">
          <h3 class="text-lg font-bold text-accent mb-2 uppercase">{ep.title}</h3>
          <div class="flex justify-between items-center mb-4">
            <span class="text-sm text-muted-foreground">{ep.date} • {ep.duration}</span>
          </div>
          <p class="text-foreground mb-4 text-sm">
            In this episode, we dive deep into web development trends, discuss design philosophy, and answer listener questions.
          </p>
          <button class="btn-accent">
            Listen Now
          </button>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <button class="btn-secondary">
        Subscribe to Podcast
      </button>
    </div>
  </div>
</section>
