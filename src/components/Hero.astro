---
---

<section class="min-h-screen bg-gradient-to-br from-background to-card flex items-center justify-center px-4 py-20">
  <div class="max-w-4xl w-full text-center">
    <div class="mb-8">
      <h1 class="text-4xl md:text-6xl font-bold text-primary mb-4 glitch">
        BUILDING THE WEB
      </h1>
      <p class="text-xl md:text-2xl text-secondary font-bold uppercase tracking-widest">
        One Click at a Time
      </p>
    </div>

    <p class="text-lg text-foreground mb-8 max-w-2xl mx-auto leading-relaxed">
      Software developer & podcast host building cool things in the digital frontier. 
      Specializing in web development, creative coding, and meaningful conversations about tech.
    </p>

    <div class="flex flex-wrap gap-4 justify-center mb-12">
      <button class="btn-primary">
        View Projects
      </button>
      <button class="btn-secondary">
        Listen to Podcast
      </button>
      <button class="btn-accent">
        Get in Touch
      </button>
    </div>

    <div class="grid grid-cols-3 gap-4 mt-12 text-center">
      <div class="bg-card border-2 border-primary p-4">
        <p class="text-2xl font-bold text-primary">50+</p>
        <p class="text-sm text-muted-foreground uppercase tracking-wide">Projects</p>
      </div>
      <div class="bg-card border-2 border-secondary p-4">
        <p class="text-2xl font-bold text-secondary">100+</p>
        <p class="text-sm text-muted-foreground uppercase tracking-wide">Episodes</p>
      </div>
      <div class="bg-card border-2 border-accent p-4">
        <p class="text-2xl font-bold text-accent">24/7</p>
        <p class="text-sm text-muted-foreground uppercase tracking-wide">Debugging</p>
      </div>
    </div>
  </div>
</section>
